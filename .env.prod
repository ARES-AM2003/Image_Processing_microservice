# ============================================
# PROCESSING LIMITS (OPTIMIZED)
# ============================================
# Worker concurrency is now AUTO-CALCULATED based on CPU count:
#   WORKER_CONCURRENCY = min(8, max(2, floor(cpu_count / 2)))
#   SHARP_THREADS_PER_JOB = min(4, max(1, floor(cpu_count / WORKER_CONCURRENCY)))
#
# This change enables parallel processing (downloading/processing/uploading 
# multiple files at once) which significantly increases throughput.
#
# The following values are no longer used by the code:
# MAX_CONCURRENT_JOBS=<auto>
# BULL_CONCURRENCY=<auto>

# ============================================
# LOGGING
# ============================================
